# Quick News Backend Environment Configuration

PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL default, or SQLite dev fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quicknews?schema=public"

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Automated Ingestion Schedule
NEWS_INGESTION_INTERVAL_MINUTES=5
NEWS_INGESTION_ENABLED=true

# Security & CORS
ADMIN_SECRET=your_admin_secret_key_here
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
